# Copy this file to "config.properties" and fill in your own values.
# IMPORTANT: config.properties is git-ignored on purpose. NEVER commit a real token.
# Create a token with the minimum scope needed (read access to the repos) at:
#   https://github.com/settings/tokens

# Your GitHub username (informational)
github.user=_USERNAME_
# Personal Access Token (read-only). Keep it secret.
github.token=_TOKEN_
# Repo list (see repositories.txt.example)
repositories.file=resources/repositories.txt
# Derived statistics output (regenerated from raw.directory)
stats.file=resources/stats.dat
# CSV export (may contain personal data: do not commit)
stats.csv=resources/stats.csv
# Local per-repository authorship assignments (ignored by Git)
authorship.directory=resources/authorship
# Original incremental downloads (ignored by Git)
raw.directory=resources/raw-data

# (Optional) Exclude the teacher account from expected-share calculations
teacher.user=_TEACHER_USERNAME_
teacher.email=_TEACHER_EMAIL_
